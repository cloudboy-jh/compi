<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Compi"
    Manufacturer="Compi"
    Version="$(var.Version)"
    UpgradeCode="{26B5FE7A-FDC6-4083-BEBD-947B3872311E}"
    Scope="perUser"
    Compressed="yes">

    <SummaryInformation Description="Compi persistent terminal" />
    <MajorUpgrade Schedule="afterInstallExecute" DowngradeErrorMessage="A newer version of Compi is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="CompiIcon" SourceFile="$(var.ProjectDir)\assets\Compi-desktopappicon-v4.ico" />
    <Property Id="ARPPRODUCTICON" Value="CompiIcon" />
    <Property Id="ARPSYSTEMCOMPONENT" Value="1" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="REBOOT" Value="ReallySuppress" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Compi">
          <Component Id="ProductFiles" Guid="{6CCA75E9-042A-408A-9F8F-4CF30DE24843}">
            <File Id="CompiExe" Source="$(var.LauncherExe)" Name="compi.exe" />
            <File Id="UpdateWorkerExe" Name="compi-update-worker.exe" Source="$(var.HelperExe)" />
            <File Id="MaintenanceExe" Name="Compi-Setup.exe" Source="$(var.MaintenanceExe)" />
            <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
            <RemoveFolder Id="RemoveProgramsFolder" Directory="ProgramsFolder" On="uninstall" />
            <RemoveFolder Id="RemovePayloadFolder" Directory="PayloadFolder" On="uninstall" />
            <RemoveFolder Id="RemoveVersionsFolder" Directory="VersionsFolder" On="uninstall" />
            <RemoveRegistryKey Root="HKCU" Key="Software\Compi\Payloads\$(var.Version)" Action="removeOnUninstall" />
            <RegistryValue
              Root="HKCU"
              Key="Software\Compi"
              Name="Installed"
              Type="integer"
              Value="1"
              KeyPath="yes" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Compi" Name="DisplayName" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Compi" Name="DisplayVersion" Type="string" Value="$(var.Version)" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Compi" Name="Publisher" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Compi" Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Compi" Name="DisplayIcon" Type="string" Value="[INSTALLFOLDER]compi.exe" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Compi" Name="UninstallString" Type="string" Value="&quot;[INSTALLFOLDER]Compi-Setup.exe&quot; --remove &quot;[ProductCode]&quot;" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Compi" Name="ModifyPath" Type="string" Value="&quot;[INSTALLFOLDER]Compi-Setup.exe&quot; --repair &quot;[ProductCode]&quot;" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Compi" Name="NoModify" Type="integer" Value="0" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Compi" Name="NoRepair" Type="integer" Value="0" />
            <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\Compi" Name="WindowsInstaller" Type="integer" Value="0" />
            <!-- Explorer: Compi in the Open with list of the file types it opens (a ProgID
                 named by each type's OpenWithProgids), in Choose another app for any file,
                 and Open in Compi on folders and folder backgrounds (Windows 11: Show more
                 options). Explorer hands compi.exe the path to open. -->
            <RegistryValue Root="HKCU" Key="Software\Classes\Applications\compi.exe" Name="FriendlyAppName" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Applications\compi.exe\DefaultIcon" Type="string" Value="[INSTALLFOLDER]compi.exe,0" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Applications\compi.exe\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]compi.exe&quot; --open &quot;%1&quot;" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Compi.File" Type="string" Value="File" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Compi.File\DefaultIcon" Type="string" Value="[INSTALLFOLDER]compi.exe,0" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Compi.File\shell\open" Name="FriendlyAppName" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Compi.File\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]compi.exe&quot; --open &quot;%1&quot;" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.txt\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.text\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.log\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.md\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.markdown\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.mdx\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.rst\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.csv\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.tsv\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.json\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.jsonc\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.json5\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.toml\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.yaml\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.yml\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.xml\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.ini\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.cfg\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.conf\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.env\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.properties\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.lock\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.sh\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.bash\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.zsh\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.fish\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.ps1\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.psm1\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.bat\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.cmd\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.rs\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.go\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.py\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.rb\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.js\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.mjs\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.cjs\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.ts\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.mts\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.cts\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.tsx\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.jsx\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.c\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.h\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.cc\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.cpp\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.hpp\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.cs\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.java\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.kt\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.kts\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.swift\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.lua\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.php\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.html\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.htm\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.css\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.scss\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.sass\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.less\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.vue\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.svelte\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.zig\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.dart\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.sql\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.graphql\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.proto\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.tf\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.nix\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.ex\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.exs\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.erl\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.hs\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.ml\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.clj\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.r\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.jl\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.png\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.jpg\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.jpeg\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.gif\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.webp\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.bmp\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.ico\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.svg\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.pdf\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.mp3\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.wav\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.flac\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.ogg\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.m4a\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.mp4\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\.webm\OpenWithProgids" Name="Compi.File" Type="string" Value="Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\Compi" Type="string" Value="Open in Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\Compi" Name="Icon" Type="string" Value="[INSTALLFOLDER]compi.exe,0" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Directory\shell\Compi\command" Type="string" Value="&quot;[INSTALLFOLDER]compi.exe&quot; --open &quot;%V&quot;" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\shell\Compi" Type="string" Value="Open in Compi" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\shell\Compi" Name="Icon" Type="string" Value="[INSTALLFOLDER]compi.exe,0" />
            <RegistryValue Root="HKCU" Key="Software\Classes\Directory\Background\shell\Compi\command" Type="string" Value="&quot;[INSTALLFOLDER]compi.exe&quot; --open &quot;%V&quot;" />
          </Component>
          <Directory Id="VersionsFolder" Name="versions">
            <Directory Id="PayloadFolder" Name="$(var.Version)">
              <!-- Running older generations remain runnable across upgrade and rollback.
                   The guarded product removal action deletes only this managed payload tree. -->
              <Component Id="PayloadClient" Guid="$(var.PayloadClientGuid)" Permanent="yes">
                <File Id="PayloadClientExe" Source="$(var.BinDir)\compi.exe" />
                <RegistryValue Root="HKCU" Key="Software\Compi\Payloads\$(var.Version)" Name="Client" Type="integer" Value="1" KeyPath="yes" />
              </Component>
              <Component Id="PayloadDaemon" Guid="$(var.PayloadDaemonGuid)" Permanent="yes">
                <File Id="DaemonExe" Source="$(var.BinDir)\compi-daemon.exe" />
                <RegistryValue Root="HKCU" Key="Software\Compi\Payloads\$(var.Version)" Name="Daemon" Type="integer" Value="1" KeyPath="yes" />
              </Component>
              <Component Id="PayloadWorker" Guid="$(var.PayloadWorkerGuid)" Permanent="yes">
                <File Id="PayloadWorkerExe" Source="$(var.HelperExe)" />
                <RegistryValue Root="HKCU" Key="Software\Compi\Payloads\$(var.Version)" Name="Worker" Type="integer" Value="1" KeyPath="yes" />
              </Component>
              <Component Id="PayloadConpty" Guid="$(var.PayloadConptyGuid)" Permanent="yes">
                <File Id="ConptyDll" Source="$(var.BinDir)\conpty.dll" />
                <RegistryValue Root="HKCU" Key="Software\Compi\Payloads\$(var.Version)" Name="Conpty" Type="integer" Value="1" KeyPath="yes" />
              </Component>
              <Component Id="PayloadOpenConsole" Guid="$(var.PayloadOpenConsoleGuid)" Permanent="yes">
                <File Id="OpenConsoleExe" Source="$(var.BinDir)\OpenConsole.exe" />
                <RegistryValue Root="HKCU" Key="Software\Compi\Payloads\$(var.Version)" Name="OpenConsole" Type="integer" Value="1" KeyPath="yes" />
              </Component>
              <Component Id="PayloadConptyLicense" Guid="$(var.PayloadConptyLicenseGuid)" Permanent="yes">
                <File Id="ConptyLicense" Source="$(var.BinDir)\ConPTY-LICENSE.txt" />
                <RegistryValue Root="HKCU" Key="Software\Compi\Payloads\$(var.Version)" Name="ConptyLicense" Type="integer" Value="1" KeyPath="yes" />
              </Component>
              <Component Id="PayloadLicense" Guid="$(var.PayloadLicenseGuid)" Permanent="yes">
                <File Id="ProductLicense" Source="$(var.ProjectDir)\LICENSE" />
                <RegistryValue Root="HKCU" Key="Software\Compi\Payloads\$(var.Version)" Name="License" Type="integer" Value="1" KeyPath="yes" />
              </Component>
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Compi">
        <Component Id="StartMenuShortcut" Guid="{CFE1A452-4223-43E1-B1D4-5AF4396C164C}">
          <Shortcut
            Id="CompiStartMenuShortcut"
            Name="Compi"
            Description="Persistent terminal"
            Target="[INSTALLFOLDER]compi.exe"
            WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue
            Root="HKCU"
            Key="Software\Compi"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Compi" Level="1">
      <ComponentRef Id="ProductFiles" />
      <ComponentRef Id="PayloadClient" />
      <ComponentRef Id="PayloadDaemon" />
      <ComponentRef Id="PayloadWorker" />
      <ComponentRef Id="PayloadConpty" />
      <ComponentRef Id="PayloadOpenConsole" />
      <ComponentRef Id="PayloadConptyLicense" />
      <ComponentRef Id="PayloadLicense" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Binary Id="MaintenanceActions" SourceFile="$(var.MaintenanceExe)" />
    <!-- Both raw MSI and Setup enforce this before the old MSI can execute removal.
         Unknown legacy live work is deferred, never implicitly ended. -->
    <CustomAction Id="GuardInstall" BinaryRef="MaintenanceActions"
      ExeCommand="--msi-guard-install &quot;[INSTALLFOLDER].&quot; &quot;$(var.Version)&quot;" Execute="immediate" Return="check" />
    <CustomAction Id="GuardRemove" BinaryRef="MaintenanceActions"
      ExeCommand="--msi-guard-remove &quot;[INSTALLFOLDER].&quot;" Execute="immediate" Return="check" />
    <CustomAction Id="GuardLegacyRemoval" BinaryRef="MaintenanceActions"
      ExeCommand="--msi-guard-install &quot;[INSTALLFOLDER].&quot; &quot;$(var.Version)&quot;" Execute="immediate" Return="check" />
    <CustomAction Id="SnapshotCompiRegistration" BinaryRef="MaintenanceActions"
      ExeCommand="--msi-snapshot &quot;[INSTALLFOLDER].&quot; &quot;[COMPI_WRAPPER_ROOT]&quot;" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="RollbackCompiRegistration" BinaryRef="MaintenanceActions"
      ExeCommand="--msi-rollback &quot;[INSTALLFOLDER].&quot; &quot;[COMPI_WRAPPER_ROOT]&quot;" Execute="rollback" Impersonate="yes" Return="check" />
    <CustomAction Id="ActivateCompiPayload" BinaryRef="MaintenanceActions"
      ExeCommand="--msi-activate &quot;[INSTALLFOLDER].&quot; &quot;$(var.Version)&quot; &quot;[UserSID]&quot; &quot;[COMPI_WRAPPER_ROOT]&quot;"
      Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="RemoveCompiTask" BinaryRef="MaintenanceActions"
      ExeCommand="--msi-remove-task &quot;[INSTALLFOLDER].&quot; &quot;[COMPI_WRAPPER_ROOT]&quot;" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="CleanupCompiPayload" BinaryRef="MaintenanceActions"
      ExeCommand="--msi-clean-product &quot;[INSTALLFOLDER].&quot; &quot;[COMPI_WRAPPER_ROOT]&quot;" Execute="commit" Impersonate="yes" Return="check" />
    <CustomAction Id="CompleteCompiTransaction" BinaryRef="MaintenanceActions"
      ExeCommand="--msi-complete &quot;[INSTALLFOLDER].&quot; &quot;[COMPI_WRAPPER_ROOT]&quot;" Execute="commit" Impersonate="yes" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="GuardInstall" Before="InstallInitialize" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="GuardRemove" Before="InstallInitialize" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RollbackCompiRegistration" After="InstallInitialize" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="SnapshotCompiRegistration" After="RollbackCompiRegistration" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="GuardLegacyRemoval" Before="RemoveExistingProducts" Condition="WIX_UPGRADE_DETECTED" />
      <Custom Action="RemoveCompiTask" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="CleanupCompiPayload" After="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ActivateCompiPayload" After="RemoveExistingProducts" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="CompleteCompiTransaction" After="ActivateCompiPayload" Condition="NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
